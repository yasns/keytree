################################################################
# App
################################################################
# Selects environment-specific behavior (local/test/dev/prod)
ENVIRONMENT=local


################################################################
# tsgauth / CERN SSO
# Client must be registered in the CERN Application Portal.
################################################################

# Signs the tsgauth session cookie. It must be random and stay secret unless you'd like to enable session forgery.
# Generate with: openssl rand -hex 32
SECRET_KEY=

OIDC_SESSION_AUTH_ALLOWED=True
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_ROUTE_PREFIX=/api/auth

# Marks the session cookie HTTPS-only.
OIDC_SESSION_COOKIE_SECURE=False
# For any environment served over HTTPS:
# OIDC_SESSION_COOKIE_SECURE=True


################################################################
# Postgres
################################################################
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=keytree

# The API connects as this user, which holds limited grants.
POSTGRES_USER=keytree_api
POSTGRES_PASSWORD=

# Should connection to Postgres be encrypted?
# For local environments only (No TLS):
POSTGRES_SSLMODE=prefer
# For deployments:
# POSTGRES_SSLMODE=require


################################################################
# Commit notification emails
################################################################
# Empty disables sending entirely.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=no-reply@keytree.app.cern.ch

# Used to build links back into the app from notification emails.
APP_BASE_URL=http://localhost:5173
