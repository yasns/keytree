# Selects environment-specific behavior (local/test/dev/main)
ENVIRONMENT=local

# Signs the tsgauth session cookie. Must stay secret - anyone with this
# value can forge session data.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# tsgauth / CERN SSO - client registered in the CERN Application Portal
# OIDC_SESSION_AUTH_ALLOWED lets the browser hit the API directly instead
# of requiring a pre-fetched bearer token.
OIDC_SESSION_AUTH_ALLOWED=True
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Keeps tsgauth's routes under /api
OIDC_AUTH_ROUTE_PREFIX=/api/auth

# Marks the session cookie HTTPS-only. Leave unset for local HTTP dev -
# browsers silently drop Secure cookies over plain HTTP, which breaks the
# session instead of just warning. Set to True in any environment served
# over HTTPS.
# OIDC_SESSION_COOKIE_SECURE=True
